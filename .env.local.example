# ─────────────────────────────────────────────────────────────
# 4Ever Inner Circle — environment variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub. It's in .gitignore already.
# ─────────────────────────────────────────────────────────────

# Supabase (Phase 1, session 3)
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Twilio (Phase 1, session 7 — SMS)
# Sign up at twilio.com when you reach the messaging engine
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (Phase 1, session 8 — Email)
# Sign up at resend.com
RESEND_API_KEY=

# Google Maps (Phase 1, session 9 — venue pins per role)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shopify (Phase 1, session 10 — The Edit shop)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=

# Stripe (Phase 2 — gift registry payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
